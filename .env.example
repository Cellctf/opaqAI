# 环境变量配置示例
# 复制此文件为 .env 并根据需要修改配置

# Flask配置
DEBUG=False
PORT=8000

# 脱敏配置
DEFAULT_REPLACEMENT=[SECRET]
DEFAULT_SCOPE=basic

# 远程API配置
REMOTE_API_ENDPOINT=https://api.openai.com # 智谱 https://open.bigmodel.cn/api/paas
REMOTE_API_KEY=your-api-key-here

# 代理配置
PROXY_TIMEOUT=300

# Gunicorn配置
GUNICORN_WORKERS=1
GUNICORN_WORKER_CLASS=sync
GUNICORN_BIND=0.0.0.0:8000
